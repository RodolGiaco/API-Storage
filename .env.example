# Copiar a .env (que no se versiona) antes de levantar docker-compose:
#   cp .env.example .env
#
# Estos mismos nombres los lee tanto docker-compose.yml (para crear el
# contenedor) como application-postgres.properties (para conectarse) --
# un solo archivo de credenciales para los dos lados.

POSTGRES_DB=api_storage
POSTGRES_USER=api_storage
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
